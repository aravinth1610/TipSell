{
  "COMMON": {
    "issuer": "{basePath}/realms/{realm}",
    "grant_types_supported": [
      "authorization_code",
      "refresh_token",
      "client_credentials",
      "password"
    ],
    "id_token_signing_alg_values_supported": [
      "HS256"
    ],
    "claims_default_supported": [
      "aud",
      "sub",
      "auth_time",
      "name"
    ],
    "claims_parameter_supported": true,
    "token_endpoint_auth_methods_supported": [
      "client_secret_post",
      "client_secret_jwt"
    ],
    "response_types_supported": [
      "code",
      "none",
      "id_token",
      "token",
      "id_token token",
      "code id_token",
      "code token",
      "code id_token token"
    ],
    "subject_types_supported": [
      "public"
    ],
    "end_session_endpoint": "http://localhost:8080/realms/master/protocol/openid-connect/logout",
    "device_authorization_endpoint": "http://localhost:8080/realms/master/protocol/openid-connect/device"
  },
  
  "AuthorizationCode": {
    "token_endpoint": "{basePath}/protocol/openid-connect/realms/{realm}/token/cisi/{cisiKey}",
    "registration": {
      "endpoint": "{basePath}/protocol/openid-connect/realms/{realm}/register/cisi/{cisiKey}",
      "request_type": "application/json",
      "parameters": ["userName", "mail", "password", "confirmPassword"]
    },
    "login": {
      "endpoint": "{basePath}/realms/{realm}/protocol/openid-connect/auth/cisi/{cisiKey}",
      "request_type": "application/x-www-form-urlencoded;charset=UTF-8",
      "parameters": ["email", "password"]
    }
},

  "clientcredential": {
   "token_endpoint": "{basePath}/protocol/openid-connect/realms/{realm}/token"
},
 
   "password": {
    "token_endpoint": "{basePath}/realms/{realm}/protocol/openid-connect/token",
    "registration": {
      "endpoint": "{basePath}/protocol/openid-connect/realms/{realm}/register/cisi/{cisiKey}",
      "request_type": "application/json",
      "parameters": ["userName", "mail", "password", "confirmPassword"]
    } 
}
  
}